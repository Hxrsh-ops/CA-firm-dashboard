# Server Configuration
PORT=3001
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Multi-Tenancy (Dev fallback tenant context)
DEFAULT_FIRM_ID=FIRM-001

# Webhook Authentication Secret (used by Make.com for x-webhook-secret header)
WEBHOOK_SECRET=ca_copilot_webhook_secret_dev_key_12345

# Make.com Outbound Integration (CA Approved reminder dispatch)
MAKE_REMINDER_WEBHOOK_URL=https://hook.eu1.make.com/your-reminder-dispatch-webhook-id

# Google Sheets MVP Database Configuration
# Set REPOSITORY_MODE to "memory" for offline/test mode, or "sheets" for live Google Sheets API
REPOSITORY_MODE=memory
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
